# Copie este arquivo para .env (não versionar .env).
# Qualquer valor preenchido substitui o padrão definido no config.py.
# As senhas MySQL podem ficar vazias: serão pedidas no terminal.

# CONEXÃO MYSQL LOCAL (na sua máquina)
LOCAL_MYSQL_HOST=127.0.0.1
LOCAL_MYSQL_PORT=3306
LOCAL_MYSQL_USER=root
LOCAL_MYSQL_PASSWORD=
LOCAL_MYSQL_SCHEMA=dev_infinity

# SERVIDOR SSH (credenciais SSH diferentes das credenciais MySQL)
SSH_HOST=
SSH_PORT=22
SSH_USER=
SSH_PASSWORD=
# Pode usar caminhos Windows: C:/Users/SEU_USUARIO/.ssh/id_ed25519
# Ou deixar vazio para detectar ~/.ssh/id_ed25519 se existir.
SSH_KEY_PATH=
SSH_KEY_PASSPHRASE=
# Para verificar a identidade do host, configure a chave PÚBLICA do SERVIDOR.
# Formato: ssh-ed25519 AAAA... ou host ssh-ed25519 AAAA... (known_hosts).
# NÃO utilize a chave privada id_ed25519 nem um fingerprint SHA256:... aqui.
# Se deixar vazio, sshtunnel 0.4.0 NÃO verifica a identidade do host.
SSH_HOST_KEY=

# MYSQL REMOTO - ENDEREÇO VISTO PELO SERVIDOR SSH
REMOTE_MYSQL_HOST=127.0.0.1
REMOTE_MYSQL_PORT=3306
REMOTE_MYSQL_USER=root
REMOTE_MYSQL_PASSWORD=
REMOTE_MYSQL_SCHEMA=dev_infinity

# Opcional: arquivo CSV gerado após a comparação
OUTPUT_CSV=diferencas_dev_infinity.csv
